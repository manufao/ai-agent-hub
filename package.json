{
  "name": "ai-agent-hub",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "pnpm run build:css && tsx watch src/index.ts",
    "prepare": "husky",
    "build": "pnpm run build:css && tsc --project tsconfig.build.json",
    "build:clean": "rm -rf ./dist && rm -rf ./public/css/output.css",
    "build:css": "pnpm exec tailwindcss -i ./src/input.css -o ./public/css/output.css",
    "build:css:watch": "pnpm exec tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier \"./**\" --write --ignore-unknown",
    "format:check": "prettier \"./**\" --ignore-unknown --check",
    "security:audit": "pnpm audit --prod",
    "security:scan": "gitleaks detect --source . -v",
    "security:check": "pnpm run security:audit && pnpm run security:scan && pnpm run lint",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.test.json"
  },
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "dotenv": "^18.0.8",
    "ejs": "^7.0.1",
    "marked": "^18.1.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
