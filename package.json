{
  "name": "ai-agent-hub",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "npm run build:css && nodemon --ext js,ts,json,env,ejs --exec 'node --experimental-specifier-resolution=node --loader ts-node/esm' src/index.ts",
    "prepare": "husky",
    "build": "npm run build:css && tsc --project tsconfig.build.json",
    "build:clean": "rm -rf tsconfig.build.tsbuildinfo && rm -rf ./dist && rm -rf ./public/css/output.css",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/output.css",
    "build:css:watch": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/output.css --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles",
    "test:coverage": "npm run test -- --coverage",
    "test:ci": "npm run test -- --colors --coverage --ci",
    "lint": "eslint .",
    "format": "prettier \"./**\" --write --ignore-unknown",
    "format:check": "prettier \"./**\" --ignore-unknown --check"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "marked": "^17.0.1",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@jest/globals": "^29.0.0",
    "@jest/types": "^29.0.0",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^29.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-tsdoc": "^0.5.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "jest": "^29.0.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.7.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
