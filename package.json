{
  "name": "ai-agent-hub",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "pnpm run build:css && tsx watch src/index.ts",
    "prepare": "husky",
    "build": "pnpm run build:css && tsc --project tsconfig.build.json",
    "build:clean": "rm -rf ./dist && rm -rf ./public/css/output.css",
    "build:css": "pnpm exec tailwindcss -i ./src/input.css -o ./public/css/output.css",
    "build:css:watch": "pnpm exec tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles --coverage",
    "test:ci": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles --colors --coverage --ci",
    "lint": "eslint .",
    "format": "prettier \"./**\" --write --ignore-unknown",
    "format:check": "prettier \"./**\" --ignore-unknown --check",
    "security:audit": "pnpm audit --prod",
    "security:scan": "gitleaks detect --source . -v",
    "security:check": "pnpm run security:audit && pnpm run security:scan && pnpm run lint"
  },
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "marked": "^17.0.1",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.0.0",
    "@jest/globals": "^30.2.0",
    "@jest/types": "^30.2.0",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/supertest": "^6.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-tsdoc": "^0.5.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
