<%_
  function current(condition) {
    return condition ? ' aria-current="page"' : ''
  }
  var totalSkills = nav.categories.reduce(function (sum, category) {
    return sum + category.skills.length
  }, 0)
_%>
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= hero ? hero.title + ' · Agents & Skills Hub' : 'Agents & Skills Hub' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body class="bg-paper text-ink">
    <div class="mx-auto flex min-h-screen max-w-[1456px] flex-col md:flex-row">
      <aside
        class="w-full shrink-0 border-b border-rule bg-panel md:sticky md:top-0 md:h-screen md:w-72 md:overflow-y-auto md:border-b-0 md:border-r"
      >
        <nav class="px-3 py-8" aria-label="Navigation principale">
          <a href="/" class="mb-6 block px-3 font-serif text-2xl font-bold leading-tight tracking-tight">
            Agents &amp; Skills Hub
          </a>

          <a href="/" class="nav-link"<%- current(active.type === 'overview') %>>Aperçu</a>

          <div class="mt-6 border-t border-rule pt-4">
            <a href="/agents" class="nav-group-title"<%- current(active.type === 'agents') %>>
              <span>Agents</span><span class="nav-count"><%= nav.agents.length %></span>
            </a>
            <% var lastGroup = '' %>
            <ul class="mt-1">
              <% nav.agents.forEach(function (agent) { %>
              <% if (agent.group !== lastGroup) { lastGroup = agent.group %>
              <li class="nav-subtitle"><%= agent.groupTitle %></li>
              <% } %>
              <li>
                <a
                  href="/agents/<%= encodeURIComponent(agent.slug) %>"
                  class="nav-link"<%- current(active.type === 'agent' && active.slug === agent.slug) %>
                >
                  <%= agent.title %>
                </a>
              </li>
              <% }) %>
            </ul>
          </div>

          <div class="mt-6 border-t border-rule pt-4">
            <a href="/skills" class="nav-group-title"<%- current(active.type === 'skills') %>>
              <span>Skills</span><span class="nav-count"><%= totalSkills %></span>
            </a>
            <% nav.categories.forEach(function (category) { %>
            <div class="mt-2">
              <a
                href="/skills/<%= encodeURIComponent(category.slug) %>"
                class="nav-link"<%- current(active.type === 'category' && active.slug === category.slug) %><%- active.type === 'skill' && active.category === category.slug ? ' data-ancestor' : '' %>
              >
                <span><%= category.title %></span><span class="nav-count"><%= category.skills.length %></span>
              </a>
              <% if (category.skills.length > 0) { %>
              <ul>
                <% category.skills.forEach(function (skill) { %>
                <li>
                  <a
                    href="/skills/<%= encodeURIComponent(category.slug) %>/<%= encodeURIComponent(skill.slug) %>"
                    class="nav-link !pl-6"<%- current(active.type === 'skill' && active.category === category.slug && active.slug === skill.slug) %>
                  >
                    <%= skill.name %>
                  </a>
                </li>
                <% }) %>
              </ul>
              <% } %>
            </div>
            <% }) %>
          </div>

          <div class="mt-6 border-t border-rule pt-4">
            <a href="/examples" class="nav-group-title"<%- current(active.type === 'examples') %>>
              <span>Exemples</span><span class="nav-count"><%= nav.examples.length %></span>
            </a>
            <ul class="mt-1">
              <% nav.examples.forEach(function (example) { %>
              <li>
                <a
                  href="/examples/<%= encodeURIComponent(example.slug) %>"
                  class="nav-link"<%- current(active.type === 'example' && active.slug === example.slug) %>
                >
                  <%= example.name %>
                </a>
              </li>
              <% }) %>
            </ul>
          </div>
        </nav>
      </aside>

      <main class="min-w-0 flex-1">
        <article>
          <% if (hero) { %>
          <header class="hero-rise grid border-b border-rule <%= hero.usage.length > 0 ? 'lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)]' : '' %>">
            <div class="px-6 py-10 sm:px-12 sm:py-14">
              <nav aria-label="Fil d'Ariane" class="text-sm text-soft">
                <% hero.crumbs.forEach(function (crumb, index) { %>
                <% if (index > 0) { %><span aria-hidden="true" class="mx-2 text-rule">/</span><% } %>
                <a href="<%= crumb.href %>" class="underline decoration-rule underline-offset-4 hover:text-ink hover:decoration-ink"><%= crumb.label %></a>
                <% }) %>
              </nav>
              <h1 class="hero-title mt-6"><%= hero.title %></h1>
              <% if (hero.description) { %>
              <p class="mt-6 max-w-[54ch] font-serif text-xl leading-relaxed text-soft"><%= hero.description %></p>
              <% } %>
            </div>
            <% if (hero.usage.length > 0) { %>
            <section aria-label="<%= hero.usageTitle %>" class="usage-column p-6">
              <h2 class="font-serif text-lg font-semibold"><%= hero.usageTitle %></h2>
              <dl class="mt-5 space-y-5 text-sm">
                <% hero.usage.forEach(function (row) { %>
                <div>
                  <dt class="font-medium text-soft"><%= row.label %></dt>
                  <dd class="mt-1.5"><code class="usage-code"><%= row.value %></code></dd>
                </div>
                <% }) %>
              </dl>
            </section>
            <% } %>
          </header>
          <% } %>

          <div class="px-6 py-10 sm:px-12 sm:py-12">
            <div class="doc prose max-w-[68ch]"><%- content %></div>
          </div>

          <% if (related.length > 0) { %>
          <section aria-label="À lire aussi" class="border-t border-rule px-6 py-10 sm:px-12">
            <h2 class="font-serif text-xl font-semibold">À lire aussi</h2>
            <div class="mt-4 grid border-t border-rule md:grid-cols-2">
              <% related.forEach(function (item) { %>
              <a href="<%= item.href %>" class="related-item">
                <span class="related-title"><%= item.title %></span>
                <% if (item.description) { %>
                <span class="mt-1 block max-w-[46ch] text-sm text-soft"><%= item.description %></span>
                <% } %>
              </a>
              <% }) %>
            </div>
          </section>
          <% } %>
        </article>
      </main>

      <% if (toc.length > 0) { %>
      <aside class="hidden w-64 shrink-0 border-l border-rule xl:block">
        <nav class="toc sticky top-0 px-6 py-10" aria-label="Sur cette page" data-toc>
          <p class="mb-3 font-serif text-base font-semibold">Sur cette page</p>
          <ul class="space-y-1">
            <% toc.forEach(function (heading) { %>
            <li><a href="#<%= encodeURIComponent(heading.id) %>"><%- heading.text %></a></li>
            <% }) %>
          </ul>
        </nav>
      </aside>
      <% } %>
    </div>

    <script>
      ;(function () {
        var links = [].slice.call(document.querySelectorAll('[data-toc] a'))
        if (links.length === 0 || !('IntersectionObserver' in window)) {
          return
        }
        var byId = {}
        links.forEach(function (link) {
          byId[link.getAttribute('href').slice(1)] = link
        })
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) {
                return
              }
              links.forEach(function (link) {
                link.removeAttribute('aria-current')
              })
              byId[entry.target.id].setAttribute('aria-current', 'true')
            })
          },
          { rootMargin: '0px 0px -70% 0px' },
        )
        Object.keys(byId).forEach(function (id) {
          var heading = document.getElementById(id)
          if (heading) {
            observer.observe(heading)
          }
        })
      })()
    </script>
  </body>
</html>
