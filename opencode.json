{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "ollama/qwen3-coder:30b",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "plan": {
      "permission": {
        "bash": "ask"
      }
    },
    "general": {
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "explore": {
      "permission": {
        "bash": "ask"
      }
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "headerTimeout": 1800000
      },
      "models": {
        "qwen3-coder:30b": { "name": "Qwen3 Coder 30B" },
        "gemma4:12b-32k": { "name": "Gemma 4 12B (32k)" },
        "mimo-v2.6:9b": { "name": "MiMo v2.6 9B (thinking)" },
        "qwen3.5:9b": { "name": "Qwen3.5 9B" }
      }
    }
  }
}
